# KVM Server Configuration
# Copy this file to kvm-server.toml and edit as needed

# Address to bind the UDP socket to
# Default: "0.0.0.0:8080"
bind_addr = "0.0.0.0:8080"

# Address of the KVM client to send input events to
# Change this to point to your macOS client machine's IP
# Example: "192.168.1.100:8080" or "mac-machine.local:8080"
client_addr = "127.0.0.1:8080"

# Screen width in pixels (for edge detection)
# Default: 1920
screen_width = 1920

# Screen height in pixels (for edge detection)
# Default: 1080
screen_height = 1080

# Logging level: "debug", "info", "warn", or "error"
# Default: "info"
# Set to "debug" for detailed event logging
log_level = "info"
